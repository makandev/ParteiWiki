# ParteiWiki – Beispiel-Konfiguration. Kopieren nach `.env` und anpassen.

# Postgres-Verbindung (Stack laut Konzept: Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://parteiwiki:parteiwiki@localhost:5432/parteiwiki

# --- RAG-Embeddings ---
# Backend: spacy_vectors (echte Wortvektoren, offline) | sbert (Transformer) | hashing
EMBEDDER=spacy_vectors
# Dimension MUSS zum Embedder passen: spacy_vectors(de_core_news_md)=300, sbert(MiniLM)=384
EMBEDDING_DIM=300
# Für sbert:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- NER-Tagging ---
# Backend: spacy (Hybrid mit Gazetteer) | gazetteer (ohne Modell)
NER=spacy
SPACY_MODEL=de_core_news_md

# --- LLM-Layer für die Antwortsynthese ---
# extractive (offline, deterministisch, belegpflichtig) | anthropic (offizielles SDK)
LLM=extractive
LLM_MODEL=claude-opus-5

# Diff-Tracking: Basis-URL des Wayback-Machine-Availability-API
WAYBACK_API=https://archive.org/wayback/available

# Redaktionelle Regel: ab wie vielen unabhängigen Quellen gilt ein Ereignis als "bestätigt".
BESTAETIGT_AB_QUELLEN=3

# Umgebung: development | production
ENV=development
