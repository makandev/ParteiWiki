# ParteiWiki – Beispiel-Konfiguration. Kopieren nach `.env` und anpassen.

# Postgres-Verbindung (Stack laut Konzept: Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://parteiwiki:parteiwiki@localhost:5432/parteiwiki

# Dimension der Embedding-Vektoren (pgvector).
# 384 passt zu multilingualen MiniLM-Modellen; bei Modellwechsel anpassen.
EMBEDDING_DIM=384

# Diff-Tracking: Basis-URL des Wayback-Machine-Availability-API
WAYBACK_API=https://archive.org/wayback/available

# Redaktionelle Regel: ab wie vielen unabhängigen Quellen gilt ein
# Ereignis als "bestätigt" (Redaktionelle Kriterien, Punkt 1).
BESTAETIGT_AB_QUELLEN=3

# Umgebung: development | production
ENV=development
